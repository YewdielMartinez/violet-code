# Copiar a .env.local (ignorado por git) y llenar con `npx supabase status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Acceso rápido de demostración en el login (chips por rol que rellenan correo y contraseña).
# Se muestra siempre en desarrollo (`npm run dev`). En un build de producción solo aparece con
# VITE_DEMO_LOGIN=true; déjalo sin definir (o distinto de "true") en cualquier despliegue real.
# Las cuentas son sintéticas (supabase/seed.sql) y comparten una contraseña pública.
# VITE_DEMO_LOGIN=true
